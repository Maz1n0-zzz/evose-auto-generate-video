# ─────────────────────────────────────────────────────────────────────────────
# TTS Provider — choose ONE option below
# ─────────────────────────────────────────────────────────────────────────────

# ElevenLabs (mặc định). Tạo tài khoản ở elevenlabs.io, lấy API key ở
# Profile → API Keys, chọn giọng rồi chép Voice ID.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL_ID=eleven_v3   # đã nghe so, v3 đọc tiếng Việt tốt nhất

# OmniVoice (TTS local, đã ngừng dùng). Chỉ bật khi tự dựng lại server:
# TTS_PROVIDER=omnivoice
# OMNIVOICE_ENDPOINT=http://127.0.0.1:8123

# ─────────────────────────────────────────────────────────────────────────────
# Advanced
# ─────────────────────────────────────────────────────────────────────────────
# TTS_CONCURRENCY=1    # parallel TTS calls (keep 1 for OmniVoice; up to 3 for ElevenLabs)
