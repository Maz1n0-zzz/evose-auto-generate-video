{
  "name": "aicoding-template-video",
  "version": "2.1.0",
  "description": "Auto-generate Vietnamese 9:16 short news videos from URL/txt using professional HyperFrames templates — Claude Code skill + OmniVoice TTS",
  "main": "src/cli.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "video:new": "tsx src/video/new.ts",
    "video:voice": "tsx src/video/voice.ts",
    "video:music": "tsx src/video/music.ts",
    "video:sfx": "tsx src/video/sfx.ts",
    "video:packets": "tsx src/video/packets.ts",
    "video:build": "tsx src/video/build.ts",
    "capture": "node scripts/capture-screenshot.js"
  },
  "keywords": [
    "video",
    "tts",
    "news",
    "vietnamese",
    "tiktok",
    "shorts",
    "hyperframes",
    "claude-code",
    "omnivoice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vntk/dictionary": "^1.0.0",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "p-limit": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nock": "^14.0.13",
    "puppeteer-core": "^25.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
